.venv/
__pycache__/
*.pyc
.env
# Any .env variant too: a `.env.bak` from editing the model line holds a
# live API key just as the original does, and `.env` alone does not match it.
.env.*
!.env.example
.pytest_cache/

# Emitted scripts and the IFC files they produce. Leading slash matters: a
# bare `generated/` would also swallow ifcfault/library/generated/, which is
# source and must be tracked.
/generated/

# Cached LLM responses and the call log.
ifcfault/.llm_cache/

# Synthesized rules are NOT tracked by default: each one is a machine-written
# file that has passed validation but not human review, and committing it
# would quietly promote it to part of the library. Review one, then
# `git add -f` it deliberately.
ifcfault/library/generated/*.py
!ifcfault/library/generated/__init__.py

# Benchmark scripts and IFCs. The TABLES are small and worth keeping,
# so they are re-included; everything a bench run emits is not.
/bench_out/*
!/bench_out/cost_review.txt
!/bench_out/cost_review.tex
!/bench_out/table.txt
!/bench_out/table.tex
!/bench_out/results.json
!/bench_out/design_modification.json
!/bench_out/design_modification.tex
!/bench_out/design_modification.txt
